node_modules/
.env

# User's personal data (not tracked)
data/

# Raw DOCX sources (not part of pipeline, kept locally for reference only)
data/*-raw-cv-data.docx

# Raw source notes (confidential project material, kept locally for reference only)
raw/

# Rendered outputs (PDFs, HTMLs)
output/

# CV modification changelog (local-only, contains PII-adjacent info)
CHANGELOG.md

# Backup directories (created by git-filter-repo, kept locally only)
.git.backup.*
.git.before-*
